<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied everywhere except the Tailscale fallback IP below.
  Delete the domain-config block once the Tailscale fallback is retired
  (see the commented BASE_URL in NetworkConfig.kt).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.95.45.33</domain>
    </domain-config>
</network-security-config>
